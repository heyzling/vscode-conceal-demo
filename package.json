{
  "name": "conceal-demo",
  "displayName": "Conceal Demo",
  "description": "A playground for the VS Code conceal API (proposal: concealedText): hide text in the editor with regex rules from settings, while the file on disk keeps every character.",
  "version": "0.1.0",
  "publisher": "heyzling",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/heyzling/vscode-conceal-demo.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "conceal",
    "concealedText",
    "decorations",
    "prettify-symbols",
    "inline fold"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "concealedText"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Conceal rules are regular expressions taken from workspace settings and run over open files."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "conceal-demo.toggle",
        "title": "Toggle Concealment",
        "category": "Conceal Demo"
      },
      {
        "command": "conceal-demo.showStats",
        "title": "Show Statistics",
        "category": "Conceal Demo"
      },
      {
        "command": "conceal-demo.showLog",
        "title": "Show Log",
        "category": "Conceal Demo"
      }
    ],
    "configuration": {
      "title": "Conceal Demo",
      "properties": {
        "conceal-demo.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Master switch. When off, nothing is concealed and no decorations are created.",
          "order": 0
        },
        "conceal-demo.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/examples/**"
          ],
          "markdownDescription": "Glob patterns a file's path must match before **any** rule is applied to it. This is the blast-radius guard: the shipped example rules would otherwise fire in every file you open. `[\"**\"]` means everywhere; `[]` means nowhere.",
          "order": 1
        },
        "conceal-demo.disableExamples": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Ignore `#conceal-demo.exampleRules#` entirely, so only your own `#conceal-demo.rules#` run.",
          "order": 2
        },
        "conceal-demo.rules": {
          "type": "array",
          "default": [],
          "markdownDescription": "Your own conceal rules. Kept separate from `#conceal-demo.exampleRules#` so the shipped demo never mixes into what you are working on.",
          "order": 3,
          "items": {
            "$ref": "#/definitions/concealRule"
          }
        },
        "conceal-demo.exampleRules": {
          "type": "array",
          "markdownDescription": "The demo rules shipped with the extension, one per case group in the survey. Same shape as `#conceal-demo.rules#`; a copy lives in `examples/default-rules.jsonc` in the repository. Turn the whole set off with `#conceal-demo.disableExamples#`.",
          "order": 4,
          "items": {
            "$ref": "#/definitions/concealRule"
          },
          "default": [
            {
              "id": "hide-md-bold-open",
              "files": [
                "**/1-hide/11-md-markup.md"
              ],
              "pattern": "\\*\\*(?=[^*]+\\*\\*)",
              "cursorStop": "before"
            },
            {
              "id": "hide-md-bold-close",
              "files": [
                "**/1-hide/11-md-markup.md"
              ],
              "pattern": "(?<=\\*\\*[^*]+)\\*\\*",
              "cursorStop": "before"
            },
            {
              "id": "hide-md-italic-open",
              "files": [
                "**/1-hide/11-md-markup.md"
              ],
              "pattern": "(?<=^|[\\s(])_(?=[^_\\s][^_]*_)",
              "cursorStop": "before"
            },
            {
              "id": "hide-md-italic-close",
              "files": [
                "**/1-hide/11-md-markup.md"
              ],
              "pattern": "(?<=(?:^|[\\s(])_[^_\\s][^_]*)_(?=$|[\\s.,!?)])",
              "cursorStop": "before"
            },
            {
              "id": "hide-md-tick-open",
              "files": [
                "**/1-hide/11-md-markup.md"
              ],
              "pattern": "`(?=[^`]+`)",
              "cursorStop": "before"
            },
            {
              "id": "hide-md-tick-close",
              "files": [
                "**/1-hide/11-md-markup.md"
              ],
              "pattern": "(?<=`[^`]+)`",
              "cursorStop": "before"
            },
            {
              "id": "hide-example-id",
              "files": [
                "**/1-hide/12-example-id-md.md"
              ],
              "pattern": "\\{![A-Za-z0-9]{6}\\} ",
              "cursorStop": "before"
            },
            {
              "id": "hide-obsidian-block-id",
              "files": [
                "**/1-hide/13-obsidian-block-id.md"
              ],
              "pattern": " \\^[a-z0-9]{6}$"
            },
            {
              "id": "replace-tag-done",
              "files": [
                "**/2-replace/21-tag-to-icon.md"
              ],
              "pattern": "#done\\b",
              "replaceWith": "✅"
            },
            {
              "id": "replace-tag-bug",
              "files": [
                "**/2-replace/21-tag-to-icon.md"
              ],
              "pattern": "#bug\\b",
              "replaceWith": "🐞"
            },
            {
              "id": "replace-tex-forall",
              "files": [
                "**/2-replace/22-latex-formula.tex"
              ],
              "pattern": "\\\\forall",
              "replaceWith": "∀",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-tex-in",
              "files": [
                "**/2-replace/22-latex-formula.tex"
              ],
              "pattern": "\\\\in\\b",
              "replaceWith": "∈",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-tex-alpha",
              "files": [
                "**/2-replace/22-latex-formula.tex"
              ],
              "pattern": "\\\\alpha",
              "replaceWith": "α",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-tex-beta",
              "files": [
                "**/2-replace/22-latex-formula.tex"
              ],
              "pattern": "\\\\beta",
              "replaceWith": "β",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-tex-gamma",
              "files": [
                "**/2-replace/22-latex-formula.tex"
              ],
              "pattern": "\\\\gamma",
              "replaceWith": "γ",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-lisp-lambda",
              "files": [
                "**/2-replace/23-lisp-lambda.el"
              ],
              "pattern": "\\blambda\\b",
              "replaceWith": "λ",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-lisp-ge",
              "files": [
                "**/2-replace/23-lisp-lambda.el"
              ],
              "pattern": ">=",
              "replaceWith": "≥",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-lisp-sqrt",
              "files": [
                "**/2-replace/23-lisp-lambda.el"
              ],
              "pattern": "\\bsqrt\\b",
              "replaceWith": "√",
              "style": {
                "color": "theme:editorInfo.foreground"
              }
            },
            {
              "id": "replace-scene-round",
              "files": [
                "**/2-replace/24-writer-scene-syntax.md"
              ],
              "pattern": "\\br(\\d+)\\b",
              "replaceWith": "⟲$1",
              "style": {
                "color": "theme:editorCodeLens.foreground"
              }
            },
            {
              "id": "replace-scene-level",
              "files": [
                "**/2-replace/24-writer-scene-syntax.md"
              ],
              "pattern": "\\bl(\\d+)\\b",
              "replaceWith": "▲$1",
              "style": {
                "color": "theme:editorCodeLens.foreground"
              }
            },
            {
              "id": "replace-scene-version",
              "files": [
                "**/2-replace/24-writer-scene-syntax.md"
              ],
              "pattern": "\\bv(\\d+)\\b",
              "replaceWith": "⌁$1",
              "style": {
                "color": "theme:editorCodeLens.foreground"
              }
            },
            {
              "id": "replace-env-value",
              "files": [
                "**/2-replace/25-password-mask.env"
              ],
              "pattern": "(?<==)\\S+$",
              "replaceWith": "•",
              "padToWidth": true,
              "padWith": "•",
              "style": {
                "color": "theme:editorWarning.foreground"
              }
            },
            {
              "id": "wall-logseq-property-line",
              "files": [
                "**/6-not-implemented/61-logseq-properties.md"
              ],
              "pattern": "^\\s*(?:id|collapsed|hl-[a-z-]+):: .*$"
            },
            {
              "id": "wall-org-property-drawer",
              "files": [
                "**/6-not-implemented/62-org-properties.org"
              ],
              "pattern": "^:[A-Z][A-Z_]*:.*$"
            },
            {
              "id": "fixture-marker-before",
              "files": [
                "**/fixtures/fixture.md"
              ],
              "pattern": "\\{![A-Za-z0-9]{6}\\} ",
              "cursorStop": "before"
            },
            {
              "id": "fixture-marker-after",
              "files": [
                "**/fixtures/fixture-after.md"
              ],
              "pattern": "\\{![A-Za-z0-9]{6}\\} ",
              "cursorStop": "after"
            },
            {
              "id": "fixture-drawn-done",
              "files": [
                "**/fixtures/fixture*.md"
              ],
              "pattern": "#done\\b",
              "replaceWith": "✅"
            },
            {
              "id": "fixture-reveal-adjacent",
              "files": [
                "**/fixtures/fixture*.md"
              ],
              "pattern": "\\(fold:[^)]*\\)",
              "replaceWith": "…",
              "reveal": "adjacent",
              "hover": true,
              "style": {
                "color": "theme:editorCodeLens.foreground"
              }
            },
            {
              "id": "fixture-view-chip",
              "files": [
                "**/fixtures/cap.md"
              ],
              "pattern": "^<!-- kms:view query=\"([^\"]*)\" limit=(\\d+) -->$",
              "replaceWith": "▸ $1 · $2",
              "style": {
                "color": "theme:editorCodeLens.foreground"
              }
            },
            {
              "id": "fixture-env-value",
              "files": [
                "**/fixtures/*.env"
              ],
              "pattern": "(?<==)\\S+$",
              "replaceWith": "•",
              "padToWidth": true,
              "padWith": "•",
              "style": {
                "color": "theme:editorWarning.foreground"
              }
            },
            {
              "id": "fixture-scene-round",
              "files": [
                "**/fixtures/types.md"
              ],
              "pattern": "\\br(\\d+)\\b",
              "replaceWith": "⟲$1"
            },
            {
              "id": "fixture-scene-level",
              "files": [
                "**/fixtures/types.md"
              ],
              "pattern": "\\bl(\\d+)\\b",
              "replaceWith": "▲$1"
            },
            {
              "id": "fixture-scene-version",
              "files": [
                "**/fixtures/types.md"
              ],
              "pattern": "\\bv(\\d+)\\b",
              "replaceWith": "⌁$1"
            }
          ]
        },
        "conceal-demo.maxMatchesPerFile": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "markdownDescription": "Stop concealing a file after this many matches. Guards against a rule such as `.` on a large file.",
          "order": 5
        },
        "conceal-demo.trace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log every recomputation to the Conceal Demo output channel.",
          "order": 6
        }
      },
      "definitions": {
        "concealRule": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "A name for this rule, used in the log and in Show Statistics."
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Set to false to keep the rule around without running it."
            },
            "pattern": {
              "type": "string",
              "description": "A JavaScript regular expression, matched line by line. A match that spans no characters is ignored."
            },
            "flags": {
              "type": "string",
              "default": "",
              "description": "Extra regular-expression flags. 'g' is always added; 'm', 's' and 'y' are rejected because matching is per line."
            },
            "group": {
              "type": "number",
              "default": 0,
              "description": "Which capture group to conceal. 0 is the whole match."
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Glob patterns the file path must match, on top of conceal-demo.include."
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Language ids this rule applies to."
            },
            "replaceWith": {
              "type": "string",
              "default": "",
              "markdownDescription": "Drawn in place of the concealed text. Empty (the default) hides it outright. `$&` is the whole match and `$1`..`$9` are capture groups — note that every distinct result costs one decoration type, because the editor carries the replacement on the type and not on the range."
            },
            "cursorStop": {
              "type": "string",
              "enum": [
                "before",
                "after"
              ],
              "default": "after",
              "markdownDescription": "Which end of the range the single caret stop stands for. Read **only** when `replaceWith` is empty: anything drawn has two sides of its own."
            },
            "padToWidth": {
              "type": "boolean",
              "default": false,
              "markdownDescription": "Pad `replaceWith` with spaces to the width of the text it hides, so nothing after it moves. Silently capped — the editor cuts a replacement to 16 characters."
            },
            "padWith": {
              "type": "string",
              "default": " ",
              "markdownDescription": "What `padToWidth` pads with. A space keeps the columns after the range where they were; repeating the replacement's own character is what a mask (`••••••`) wants."
            },
            "hover": {
              "type": "boolean",
              "default": false,
              "description": "Show the concealed text in a hover over the range."
            },
            "reveal": {
              "type": "string",
              "enum": [
                "never",
                "adjacent",
                "line",
                "selection"
              ],
              "default": "never",
              "markdownDescription": "When to stop concealing a range: `never`, when a caret rests against it (`adjacent`), anywhere on its line (`line`), or when a selection covers it (`selection`). Anything but `never` reflows the line as the caret arrives."
            },
            "style": {
              "type": "object",
              "description": "How the replacement is drawn. Ignored when replaceWith is empty.",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "type": "string"
                },
                "backgroundColor": {
                  "type": "string"
                },
                "border": {
                  "type": "string"
                },
                "borderRadius": {
                  "type": "string"
                },
                "fontStyle": {
                  "type": "string"
                },
                "fontWeight": {
                  "type": "string"
                },
                "textDecoration": {
                  "type": "string"
                },
                "margin": {
                  "type": "string"
                },
                "width": {
                  "type": "string"
                },
                "height": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && npm run check-example-rules && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "sync-example-rules": "node scripts/sync-example-rules.js",
    "check-example-rules": "node scripts/sync-example-rules.js --check",
    "test": "vscode-test",
    "test:fork": "./scripts/test-fork.sh",
    "test:unit": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "vsix": "vsce package --pre-release --skip-license -o ./builds/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "glob": "^11.0.3"
  }
}
