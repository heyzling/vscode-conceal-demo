{
  "settleMs": 450,
  "scenes": [
    {
      "id": "11-markdown-tags",
      "title": "Replace — a tag drawn as its icon",
      "example": "1-replace/tags.md",
      "window": [
        1280,
        420
      ],
      "steps": [
        {
          "caption": "Concealment OFF: #done and #bug, as they are written",
          "hold": 2.4,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": false
            }
          ]
        },
        {
          "caption": "Concealment ON: each tag drawn as one glyph",
          "hold": 2.4,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": true
            }
          ]
        },
        {
          "caption": "Copy preserves original text",
          "hold": 2.7,
          "do": [
            {
              "select": [
                3,
                1,
                4,
                22
              ]
            },
            {
              "copy": true
            },
            {
              "openBeside": true
            },
            {
              "paste": true
            }
          ]
        },
        {
          "caption": "Copy the glyph alone: also preserves original text",
          "hold": 2.7,
          "do": [
            {
              "open": "1-replace/tags.md"
            },
            {
              "select": [
                3,
                3,
                3,
                8
              ]
            },
            {
              "copy": true
            },
            {
              "openBeside": true
            },
            {
              "paste": true
            }
          ]
        }
      ]
    },
