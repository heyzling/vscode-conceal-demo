      "id": "11-toggle",
      "title": "Tags — concealment on and off",
      "example": "1-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Concealment OFF: the tags are real text",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [1, 1]}]
        },
        {
          "caption": "Concealment ON: #done and #bug drawn as glyphs",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        }
