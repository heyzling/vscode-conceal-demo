    {
      "id": "31-caret",
      "title": "Invisible markers — a caret crossing what is not drawn",
      "example": "3-invisible-markers/notes.md",
      "window": [
        1280,
        500
      ],
      "steps": [
        {
          "caption": "Concealment OFF: a marker on every record, and two tags among them",
          "hold": 2.4,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": false
            },
            {
              "caret": [
                4,
                3
              ]
            }
          ]
        },
        {
          "caption": "Concealment ON: the markers gone, the tags drawn, the records the same",
          "hold": 2.4,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": true
            }
          ]
        },
        {
          "caption": "A list item: the caret at the marker's left edge, after the dash",
          "hold": 2.4,
          "do": [
            {
              "caret": [
                4,
                3
              ]
            }
          ]
        },
        {
          "caption": "← once: an ordinary step left, into the gap after the dash",
          "hold": 2.4,
          "do": [
            {
              "command": "cursorLeft"
            }
          ]
        },
        {
          "caption": "→ once: an ordinary step back, onto the marker's edge",
          "hold": 2.4,
          "do": [
            {
              "command": "cursorRight"
            }
          ]
        },
        {
          "caption": "→ again: one cell on screen, thirteen characters in the file",
          "hold": 3.0,
          "do": [
            {
              "command": "cursorRight"
            }
          ]
        },
        {
          "caption": "Concealment OFF: that one press crossed the whole marker",
          "hold": 3.0,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": false
            }
          ]
        },
        {
          "caption": "A paragraph: the marker's one stop is column 1",
          "hold": 2.7,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": true
            },
            {
              "caret": [
                7,
                1
              ]
            }
          ]
        },
        {
          "caption": "← once and the line is gone: the marker holds no stop of its own",
          "hold": 2.7,
          "do": [
            {
              "command": "cursorLeft"
            }
          ]
        }
      ]
    },
    {
      "id": "32-delete-and-copy",
      "title": "Invisible markers — what a delete takes, and what the clipboard carries",
      "example": "3-invisible-markers/notes.md",
      "window": [
        1280,
        500
      ],
      "steps": [
        {
          "caption": "Concealment ON: four ids, none of them on screen",
          "hold": 2.4,
          "do": [
            {
              "caret": [
                7,
                21
              ]
            }
          ]
        },
        {
          "caption": "Ctrl+Backspace erases the word: the marker it cannot see is untouched",
          "hold": 2.7,
          "do": [
            {
              "command": "deleteWordLeft"
            }
          ]
        },
        {
          "caption": "Again: the record looks empty, and its id is still inside it",
          "hold": 2.7,
          "do": [
            {
              "command": "deleteWordLeft"
            }
          ]
        },
        {
          "caption": "BUG: one Delete takes all twelve hidden characters, and nothing says so",
          "hold": 3.0,
          "do": [
            {
              "command": "deleteRight"
            }
          ]
        },
        {
          "caption": "Concealment OFF: that id really is gone, where the others are still there",
          "hold": 3.0,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": false
            }
          ]
        },
        {
          "caption": "Ctrl + Z, and every record is back",
          "hold": 2.4,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": true
            },
            {
              "command": "undo"
            },
            {
              "command": "undo"
            },
            {
              "command": "undo"
            }
          ]
        },
        {
          "caption": "Copy one record: the id comes with it, having never been on screen",
          "hold": 2.7,
          "do": [
            {
              "select": [
                7,
                1,
                7,
                21
              ]
            },
            {
              "copy": true
            },
            {
              "openBeside": true
            },
            {
              "paste": true
            }
          ]
        }
      ]
