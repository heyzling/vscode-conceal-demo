{
  "settleMs": 450,
  "scenes": [
    {
      "id": "11-md-markup",
      "title": "Hide — markdown emphasis markers",
      "example": "1-hide/11-md-markup.md",
      "window": [
        1280,
        380
      ],
      "steps": [
        {
          "caption": "Concealment OFF: visible Markdown markers",
          "hold": 2.4,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": false
            }
          ]
        },
        {
          "caption": "Concealment ON: the markers are gone",
          "hold": 2.4,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": true
            }
          ]
        },
        {
          "caption": "Copy preserves original text",
          "hold": 2.7,
          "do": [
            {
              "select": [
                3,
                1,
                3,
                28
              ]
            },
            {
              "copy": true
            },
            {
              "openBeside": true
            },
            {
              "paste": true
            }
          ]
        }
      ]
    },
