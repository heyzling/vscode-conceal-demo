    {
      "id": "61-logseq-properties",
      "title": "Not implemented — property lines own a whole row",
      "example": "6-not-implemented/61-logseq-properties.md",
      "window": [
        1280,
        420
      ],
      "steps": [
        {
          "caption": "The property lines are hidden — and two blank rows are left",
          "hold": 2.2
        },
        {
          "caption": "Concealment OFF: id:: and collapsed:: own a line each",
          "hold": 2.2,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": false
            }
          ]
        },
        {
          "caption": "On again. Hiding a line's text cannot hide the line",
          "hold": 2.0,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": true
            }
          ]
        },
        {
          "caption": "And the gutter stops numbering them: 1, 2, 3, then 6",
          "hold": 2.4,
          "do": [
            {
              "caret": [
                6,
                1
              ]
            }
          ]
        },
        {
          "caption": "cursorStop \"before\" gives the numbers back — the rows stay",
          "hold": 2.6,
          "do": [
            {
              "rule": "wall-logseq-property-line",
              "patch": {
                "cursorStop": "before"
              }
            }
          ]
        }
      ]
    },
