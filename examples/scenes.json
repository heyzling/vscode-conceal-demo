        {
          "caption": "Concealment OFF: the match is on the real text",
          "hold": 2.5,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        },
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        },
        {
          "caption": "Ctrl + F: finds bug under the chip",
          "hold": 2.5,
          "do": [
            {"command": "editor.actions.findWithArgs", "args": [{"searchString": "bug"}]},
