    {
      "id": "21-lisp",
      "title": "Caret — crossing and deleting a drawn glyph",
      "example": "2-caret/lambda.el",
      "window": [
        1280,
        340
      ],
      "steps": [
        {
          "caption": "The caret rests on the right of λ",
          "hold": 2.4,
          "do": [
            {
              "caret": [
                1,
                8
              ]
            }
          ]
        },
        {
          "caption": "← crosses all six hidden characters in one press",
          "hold": 2.4,
          "do": [
            {
              "command": "cursorLeft"
            }
          ]
        },
        {
          "caption": "→ crosses back, one press again",
          "hold": 2.4,
          "do": [
            {
              "command": "cursorRight"
            }
          ]
        },
        {
          "caption": "Backspace takes the whole glyph — Ctrl+Backspace works the same",
          "hold": 2.7,
          "do": [
            {
              "command": "deleteLeft"
            }
          ]
        },
        {
          "caption": "Ctrl+Z brings all back at once",
          "hold": 2.4,
          "do": [
            {
              "command": "undo"
            },
            {
              "caret": [
                1,
                8
              ]
            }
          ]
        },
        {
          "caption": "← once more: the caret is now on the glyph's left side",
          "hold": 2.4,
          "do": [
            {
              "command": "cursorLeft"
            }
          ]
        },
        {
          "caption": "Delete from the left takes the whole glyph too",
          "hold": 2.7,
          "do": [
            {
              "command": "deleteRight"
            }
          ]
        },
        {
          "caption": "Concealment OFF: lambda really is gone from the file",
          "hold": 3.0,
          "do": [
            {
              "setting": "conceal-demo.enabled",
              "value": false
            }
          ]
        }
      ]
    },
