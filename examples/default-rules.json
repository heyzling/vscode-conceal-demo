{
  "conceal-demo.exampleRules": [
    {
      "id": "tag-done",
      "files": [
        "**/1-replace/*.md",
        "**/2-caret/*.md",
        "**/3-invisible-markers/*.md"
      ],
      "pattern": "#done\\b",
      "replaceWith": "✅"
    },
    {
      "id": "tag-bug",
      "files": [
        "**/1-replace/*.md",
        "**/2-caret/*.md",
        "**/3-invisible-markers/*.md"
      ],
      "pattern": "#bug\\b",
      "replaceWith": "🐞"
    },
    {
      "id": "ts-fat-arrow",
      "files": [
        "**/1-replace/*.ts"
      ],
      "pattern": "=>",
      "replaceWith": "⇒",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "tex-forall",
      "files": [
        "**/1-replace/*.tex",
        "**/2-caret/*.tex"
      ],
      "pattern": "\\\\forall(?![A-Za-z])",
      "replaceWith": "∀",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "tex-in",
      "files": [
        "**/1-replace/*.tex",
        "**/2-caret/*.tex"
      ],
      "pattern": "\\\\in(?![A-Za-z])",
      "replaceWith": "∈",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "tex-alpha",
      "files": [
        "**/1-replace/*.tex",
        "**/2-caret/*.tex"
      ],
      "pattern": "\\\\alpha(?![A-Za-z])",
      "replaceWith": "α",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "tex-beta",
      "files": [
        "**/1-replace/*.tex",
        "**/2-caret/*.tex"
      ],
      "pattern": "\\\\beta(?![A-Za-z])",
      "replaceWith": "β",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "tex-gamma",
      "files": [
        "**/1-replace/*.tex",
        "**/2-caret/*.tex"
      ],
      "pattern": "\\\\gamma(?![A-Za-z])",
      "replaceWith": "γ",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "tex-rightarrow",
      "files": [
        "**/1-replace/*.tex",
        "**/2-caret/*.tex"
      ],
      "pattern": "\\\\rightarrow(?![A-Za-z])",
      "replaceWith": "→",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "lisp-lambda",
      "files": [
        "**/1-replace/*.el",
        "**/2-caret/*.el"
      ],
      "pattern": "\\blambda\\b",
      "replaceWith": "λ",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "lisp-ge",
      "files": [
        "**/1-replace/*.el",
        "**/2-caret/*.el"
      ],
      "pattern": ">=",
      "replaceWith": "≥",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "md-id",
      "files": [
        "**/3-invisible-markers/*.md"
      ],
      "pattern": "(?<=^(?:[-*] )?)\\{ID:[A-Za-z0-9]{6}\\} ",
      "cursorStop": "before"
    },
    {
      "id": "md-bold-open",
      "files": [
        "**/4-hide-markup/*.md"
      ],
      "pattern": "\\*\\*(?=[^*]+\\*\\*)"
    },
    {
      "id": "md-bold-close",
      "files": [
        "**/4-hide-markup/*.md"
      ],
      "pattern": "(?<=\\*\\*[^*]+)\\*\\*"
    },
    {
      "id": "md-italic-open",
      "files": [
        "**/4-hide-markup/*.md"
      ],
      "pattern": "(?<=^|[\\s(])_(?=[^_\\s][^_]*_)"
    },
    {
      "id": "md-italic-close",
      "files": [
        "**/4-hide-markup/*.md"
      ],
      "pattern": "(?<=(?:^|[\\s(])_[^_\\s][^_]*)_(?=$|[\\s.,!?)])"
    },
    {
      "id": "md-tick-open",
      "files": [
        "**/4-hide-markup/*.md"
      ],
      "pattern": "`(?=[^`]+`)"
    },
    {
      "id": "md-tick-close",
      "files": [
        "**/4-hide-markup/*.md"
      ],
      "pattern": "(?<=`[^`]+)`"
    },
    {
      "id": "json-key-open",
      "files": [
        "**/4-hide-markup/*.json"
      ],
      "pattern": "\"(?=[A-Za-z_][\\w-]*\"\\s*:)"
    },
    {
      "id": "json-key-close",
      "files": [
        "**/4-hide-markup/*.json"
      ],
      "pattern": "(?<=\"[A-Za-z_][\\w-]*)\"(?=\\s*:)"
    },
    {
      "id": "json-value-open",
      "files": [
        "**/4-hide-markup/*.json"
      ],
      "pattern": "(?<=:\\s)\"(?=[^\"]*\")"
    },
    {
      "id": "json-value-close",
      "files": [
        "**/4-hide-markup/*.json"
      ],
      "pattern": "(?<=:\\s\"[^\"]*)\""
    },
    {
      "id": "fixture-marker-before",
      "files": [
        "**/fixtures/fixture.md"
      ],
      "pattern": "\\{![A-Za-z0-9]{6}\\} ",
      "cursorStop": "before"
    },
    {
      "id": "fixture-marker-after",
      "files": [
        "**/fixtures/fixture-after.md"
      ],
      "pattern": "\\{![A-Za-z0-9]{6}\\} ",
      "cursorStop": "after"
    },
    {
      "id": "fixture-drawn-done",
      "files": [
        "**/fixtures/fixture*.md"
      ],
      "pattern": "#done\\b",
      "replaceWith": "✅"
    },
    {
      "id": "fixture-reveal-adjacent",
      "files": [
        "**/fixtures/fixture*.md"
      ],
      "pattern": "\\(fold:[^)]*\\)",
      "replaceWith": "…",
      "reveal": "adjacent",
      "hover": true,
      "style": {
        "color": "theme:editorCodeLens.foreground"
      }
    },
    {
      "id": "fixture-view-chip",
      "files": [
        "**/fixtures/cap.md"
      ],
      "pattern": "^<!-- kms:view query=\"([^\"]*)\" limit=(\\d+) -->$",
      "replaceWith": "▸ $1 · $2",
      "style": {
        "color": "theme:editorCodeLens.foreground"
      }
    },
    {
      "id": "fixture-env-value",
      "files": [
        "**/fixtures/*.env"
      ],
      "pattern": "(?<==)\\S+$",
      "replaceWith": "•",
      "padToWidth": true,
      "padWith": "•",
      "style": {
        "color": "theme:editorWarning.foreground"
      }
    },
    {
      "id": "fixture-scene-round",
      "files": [
        "**/fixtures/types.md"
      ],
      "pattern": "\\br(\\d+)\\b",
      "replaceWith": "⟲$1"
    },
    {
      "id": "fixture-scene-level",
      "files": [
        "**/fixtures/types.md"
      ],
      "pattern": "\\bl(\\d+)\\b",
      "replaceWith": "▲$1"
    },
    {
      "id": "fixture-scene-version",
      "files": [
        "**/fixtures/types.md"
      ],
      "pattern": "\\bv(\\d+)\\b",
      "replaceWith": "⌁$1"
    }
  ]
}
