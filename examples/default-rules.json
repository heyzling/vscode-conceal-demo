{
  "conceal-demo.exampleRules": [
    {
      "id": "hide-md-bold-open",
      "files": [
        "**/1-hide/11-md-markup.md"
      ],
      "pattern": "\\*\\*(?=[^*]+\\*\\*)",
      "cursorStop": "before"
    },
    {
      "id": "hide-md-bold-close",
      "files": [
        "**/1-hide/11-md-markup.md"
      ],
      "pattern": "(?<=\\*\\*[^*]+)\\*\\*",
      "cursorStop": "before"
    },
    {
      "id": "hide-md-italic-open",
      "files": [
        "**/1-hide/11-md-markup.md"
      ],
      "pattern": "(?<=^|[\\s(])_(?=[^_\\s][^_]*_)",
      "cursorStop": "before"
    },
    {
      "id": "hide-md-italic-close",
      "files": [
        "**/1-hide/11-md-markup.md"
      ],
      "pattern": "(?<=(?:^|[\\s(])_[^_\\s][^_]*)_(?=$|[\\s.,!?)])",
      "cursorStop": "before"
    },
    {
      "id": "hide-md-tick-open",
      "files": [
        "**/1-hide/11-md-markup.md"
      ],
      "pattern": "`(?=[^`]+`)",
      "cursorStop": "before"
    },
    {
      "id": "hide-md-tick-close",
      "files": [
        "**/1-hide/11-md-markup.md"
      ],
      "pattern": "(?<=`[^`]+)`",
      "cursorStop": "before"
    },
    {
      "id": "hide-example-id",
      "files": [
        "**/1-hide/12-example-id-md.md"
      ],
      "pattern": "\\{![A-Za-z0-9]{6}\\} ",
      "cursorStop": "before"
    },
    {
      "id": "hide-obsidian-block-id",
      "files": [
        "**/1-hide/13-obsidian-block-id.md"
      ],
      "pattern": " \\^[a-z0-9]{6}$"
    },
    {
      "id": "replace-tag-done",
      "files": [
        "**/2-replace/21-tag-to-icon.md"
      ],
      "pattern": "#done\\b",
      "replaceWith": "✅"
    },
    {
      "id": "replace-tag-bug",
      "files": [
        "**/2-replace/21-tag-to-icon.md"
      ],
      "pattern": "#bug\\b",
      "replaceWith": "🐞"
    },
    {
      "id": "replace-tex-forall",
      "files": [
        "**/2-replace/22-latex-formula.tex"
      ],
      "pattern": "\\\\forall",
      "replaceWith": "∀",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-tex-in",
      "files": [
        "**/2-replace/22-latex-formula.tex"
      ],
      "pattern": "\\\\in\\b",
      "replaceWith": "∈",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-tex-alpha",
      "files": [
        "**/2-replace/22-latex-formula.tex"
      ],
      "pattern": "\\\\alpha",
      "replaceWith": "α",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-tex-beta",
      "files": [
        "**/2-replace/22-latex-formula.tex"
      ],
      "pattern": "\\\\beta",
      "replaceWith": "β",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-tex-gamma",
      "files": [
        "**/2-replace/22-latex-formula.tex"
      ],
      "pattern": "\\\\gamma",
      "replaceWith": "γ",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-lisp-lambda",
      "files": [
        "**/2-replace/23-lisp-lambda.el"
      ],
      "pattern": "\\blambda\\b",
      "replaceWith": "λ",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-lisp-ge",
      "files": [
        "**/2-replace/23-lisp-lambda.el"
      ],
      "pattern": ">=",
      "replaceWith": "≥",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-lisp-sqrt",
      "files": [
        "**/2-replace/23-lisp-lambda.el"
      ],
      "pattern": "\\bsqrt\\b",
      "replaceWith": "√",
      "style": {
        "color": "theme:editorInfo.foreground"
      }
    },
    {
      "id": "replace-scene-round",
      "files": [
        "**/2-replace/24-writer-scene-syntax.md"
      ],
      "pattern": "\\br(\\d+)\\b",
      "replaceWith": "⟲$1",
      "style": {
        "color": "theme:editorCodeLens.foreground"
      }
    },
    {
      "id": "replace-scene-level",
      "files": [
        "**/2-replace/24-writer-scene-syntax.md"
      ],
      "pattern": "\\bl(\\d+)\\b",
      "replaceWith": "▲$1",
      "style": {
        "color": "theme:editorCodeLens.foreground"
      }
    },
    {
      "id": "replace-scene-version",
      "files": [
        "**/2-replace/24-writer-scene-syntax.md"
      ],
      "pattern": "\\bv(\\d+)\\b",
      "replaceWith": "⌁$1",
      "style": {
        "color": "theme:editorCodeLens.foreground"
      }
    },
    {
      "id": "replace-env-value",
      "files": [
        "**/2-replace/25-password-mask.env"
      ],
      "pattern": "(?<==)\\S+$",
      "replaceWith": "•",
      "padToWidth": true,
      "padWith": "•",
      "style": {
        "color": "theme:editorWarning.foreground"
      }
    },
    {
      "id": "wall-logseq-property-line",
      "files": [
        "**/6-not-implemented/61-logseq-properties.md"
      ],
      "pattern": "^\\s*(?:id|collapsed|hl-[a-z-]+):: .*$"
    },
    {
      "id": "wall-org-property-drawer",
      "files": [
        "**/6-not-implemented/62-org-properties.org"
      ],
      "pattern": "^:[A-Z][A-Z_]*:.*$"
    },
    {
      "id": "fixture-marker-before",
      "files": [
        "**/fixtures/fixture.md"
      ],
      "pattern": "\\{![A-Za-z0-9]{6}\\} ",
      "cursorStop": "before"
    },
    {
      "id": "fixture-marker-after",
      "files": [
        "**/fixtures/fixture-after.md"
      ],
      "pattern": "\\{![A-Za-z0-9]{6}\\} ",
      "cursorStop": "after"
    },
    {
      "id": "fixture-drawn-done",
      "files": [
        "**/fixtures/fixture*.md"
      ],
      "pattern": "#done\\b",
      "replaceWith": "✅"
    },
    {
      "id": "fixture-reveal-adjacent",
      "files": [
        "**/fixtures/fixture*.md"
      ],
      "pattern": "\\(fold:[^)]*\\)",
      "replaceWith": "…",
      "reveal": "adjacent",
      "hover": true,
      "style": {
        "color": "theme:editorCodeLens.foreground"
      }
    },
    {
      "id": "fixture-view-chip",
      "files": [
        "**/fixtures/cap.md"
      ],
      "pattern": "^<!-- kms:view query=\"([^\"]*)\" limit=(\\d+) -->$",
      "replaceWith": "▸ $1 · $2",
      "style": {
        "color": "theme:editorCodeLens.foreground"
      }
    },
    {
      "id": "fixture-env-value",
      "files": [
        "**/fixtures/*.env"
      ],
      "pattern": "(?<==)\\S+$",
      "replaceWith": "•",
      "padToWidth": true,
      "padWith": "•",
      "style": {
        "color": "theme:editorWarning.foreground"
      }
    },
    {
      "id": "fixture-scene-round",
      "files": [
        "**/fixtures/types.md"
      ],
      "pattern": "\\br(\\d+)\\b",
      "replaceWith": "⟲$1"
    },
    {
      "id": "fixture-scene-level",
      "files": [
        "**/fixtures/types.md"
      ],
      "pattern": "\\bl(\\d+)\\b",
      "replaceWith": "▲$1"
    },
    {
      "id": "fixture-scene-version",
      "files": [
        "**/fixtures/types.md"
      ],
      "pattern": "\\bv(\\d+)\\b",
      "replaceWith": "⌁$1"
    }
  ]
}
