          "live": 0.12,
          "do": [{"type": "\n$\\gamma \\leq \\pi$"}],
          "expect": {"lines": {"3": "$\\gamma \\leq \\pi$"}, "caret": [3, 18], "press": ["cursorRight", [3, 2], [3, 8]]}
        },
        {
          "caption": "←",
          "hold": 1.1,
          "do": [{"command": "cursorLeft"}],
          "expect": {"caret": [3, 17]}
        },
        {
          "caption": "Backspace: real text revealed, nothing deleted",
          "hold": 1.8,
          "do": [{"command": "deleteLeft"}],
          "expect": {"unchanged": true, "caret": [3, 17], "press": ["cursorRight", [3, 14], [3, 15]]}
        },
        {
          "caption": "Backspace",
          "hold": 1.5,
          "do": [{"command": "deleteLeft"}],
          "expect": {"lines": {"3": "$\\gamma \\leq \\p$"}, "caret": [3, 16]}
        },
        {
          "caption": "i",
          "hold": 1.5,
          "live": 0.3,
          "do": [{"type": "i"}],
          "expect": {"lines": {"3": "$\\gamma \\leq \\pi$"}, "caret": [3, 17]}
        },
        {
          "caption": "→: drawn again",
          "hold": 2.1,
          "do": [{"command": "cursorRight"}],
          "expect": {"caret": [3, 18], "press": ["cursorRight", [3, 14], [3, 17]]}
        }
      ]
    },
    {
      "id": "0505-tags",
      "title": "Gallery — a tag rotated in place",
      "example": "05-gallery/todo.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "Start: after ⬜, the #todo glyph",
          "hold": 1.1,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [3, 8]}],
          "expect": {"caret": [3, 8]}
        },
        {
          "caption": "Rotate Tag: #todo becomes #done",
          "hold": 1.8,
          "do": [{"command": "conceal-demo.rotateTag"}],
          "expect": {"lines": {"3": "- #done Write the gallery"}, "press": ["cursorRight", [3, 3], [3, 8]]}
        },
        {
          "caption": "Rotate Tag: back to #todo",
          "hold": 2.1,
          "do": [{"command": "conceal-demo.rotateTag"}],
          "expect": {"lines": {"3": "- #todo Write the gallery"}, "press": ["cursorRight", [3, 3], [3, 8]]}
        }
      ]
    },
    {
      "id": "0506-fold",
      "title": "Gallery — a long value folded, shown on Backspace, folded again",
      "example": "05-gallery/card.html",
      "window": [1280, 560],
      "steps": [
        {
          "caption": "Start: after •••, a folded class list",
          "hold": 1.1,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [5, 64]}],
          "expect": {"caret": [5, 64]}
        },
        {
          "caption": "Backspace: real text revealed, nothing deleted",
          "hold": 1.8,
          "do": [{"command": "deleteLeft"}],
          "expect": {"unchanged": true, "caret": [5, 64], "press": ["cursorRight", [5, 15], [5, 16]]}
        },
        {
          "caption": "italic",
          "hold": 1.5,
          "live": 0.15,
          "do": [{"type": " italic"}],
          "expect": {"lines": {"5": "    <p class=\"label truncate text-slate-700 dark:text-slate-200 italic\">Demo</p>"}, "caret": [5, 71]}
        },
        {
          "caption": "→ →: folded again",
          "hold": 2.1,
          "live": 0.5,
          "do": [{"command": "cursorRight", "times": 2}],
          "expect": [{"caret": [5, 72]}, {"caret": [5, 73], "press": ["cursorRight", [5, 15], [5, 71]]}]
        }
      ]
    }
  ]
}
