{
  "settleMs": 450,
  "scenes": [
    {
      "id": "0101-toggle",
      "title": "Tags — concealment on and off",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Concealment OFF: the tags are real text",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [1, 1]}]
        },
        {
          "caption": "Concealment ON: #done and #bug drawn as glyphs",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        }
      ]
    },
    {
      "id": "0102-search",
      "title": "Tags — search finds the text under the glyph",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"caret": [1, 1]}]
        },
        {
          "caption": "Ctrl + F: finds done under the glyph",
          "hold": 2.5,
          "do": [
            {"command": "editor.actions.findWithArgs", "args": [{"searchString": "done"}]},
            {"command": "editor.action.nextMatchFindAction"}
          ]
        },
        {
          "caption": "Concealment OFF: the match is on the real text",
          "hold": 2.5,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        },
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        },
        {
          "caption": "Ctrl + F: finds bug under the chip",
          "hold": 2.5,
          "do": [
            {"command": "editor.actions.findWithArgs", "args": [{"searchString": "bug"}]},
            {"command": "editor.action.nextMatchFindAction"}
          ]
        },
        {
          "caption": "Concealment OFF: the match is on the real text",
          "hold": 2.5,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0103-copy",
      "title": "Tags — what the clipboard carries",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Select and copy the lines with glyphs",
          "hold": 1.2,
          "live": 0.35,
          "do": [{"select": [8, 1, 9, 22]}]
        },
        {
          "caption": "Open an empty tab beside it",
          "hold": 1.2,
          "do": [{"copy": true}, {"openBeside": true}]
        },
        {
          "caption": "Copy preserves the original text",
          "hold": 2.7,
          "do": [{"paste": true}]
        },
        {
          "caption": "Close the tab",
          "hold": 1.2,
          "do": [{"closeBeside": true}]
        },
        {
          "caption": "Select only the #done glyph",
          "hold": 1.2,
          "live": 0.35,
          "do": [{"select": [8, 3, 8, 8]}]
        },
        {
          "caption": "Open an empty tab beside it",
          "hold": 1.2,
          "do": [{"copy": true}, {"openBeside": true}]
        },
        {
          "caption": "Copy the glyph alone: also the original text",
          "hold": 2.7,
          "do": [{"paste": true}]
        },
        {
          "caption": "Close the tab",
          "hold": 1.2,
          "do": [{"closeBeside": true}]
        },
        {
          "caption": "Select only the #bug chip",
          "hold": 1.2,
          "live": 0.35,
          "do": [{"select": [9, 3, 9, 7]}]
        },
        {
          "caption": "Open an empty tab beside it",
          "hold": 1.2,
          "do": [{"copy": true}, {"openBeside": true}]
        },
        {
          "caption": "Copy the chip alone: also the original text",
          "hold": 2.7,
          "do": [{"paste": true}]
        }
      ]
    },
    {
      "id": "0104-caret",
      "title": "Tags — the caret around a glyph",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Put the caret at the right of the glyph",
          "hold": 1.6,
          "do": [{"caret": [8, 8]}]
        },
        {
          "caption": "Put the caret after Ship",
          "hold": 1.6,
          "skip": true,
          "do": [{"caret": [8, 13]}]
        },
        {
          "caption": "Move left to the glyph",
          "hold": 1.5,
          "live": 0.27,
          "skip": true,
          "do": [{"command": "cursorLeft", "times": 5}]
        },
        {
          "caption": "←: crosses the whole glyph",
          "hold": 2.2,
          "do": [{"command": "cursorLeft"}]
        },
        {
          "caption": "→: goes back",
          "hold": 2.2,
          "do": [{"command": "cursorRight"}]
        },
        {
          "caption": "Ctrl + ←: A word jump also works",
          "hold": 2.2,
          "do": [{"command": "cursorWordLeft"}]
        },
        {
          "caption": "Ctrl + →: A word jump back",
          "hold": 2.2,
          "do": [{"command": "cursorWordRight"}]
        },
        {
          "caption": "Concealment OFF: the caret stays where it was",
          "hold": 2.2,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        },
        {
          "caption": "Now the caret walks #done letter by letter",
          "hold": 2.7,
          "live": 0.27,
          "do": [{"command": "cursorLeft", "times": 5}]
        },
        {
          "caption": "Concealment ON, the caret at the right of the chip",
          "hold": 1.6,
          "do": [{"setting": "editor.conceal.enabled", "value": true}, {"caret": [9, 7]}]
        },
        {
          "caption": "←: crosses the whole chip",
          "hold": 2.2,
          "do": [{"command": "cursorLeft"}]
        },
        {
          "caption": "→: goes back",
          "hold": 2.2,
          "do": [{"command": "cursorRight"}]
        },
        {
          "caption": "Ctrl + ←: A word jump also works",
          "hold": 2.2,
          "do": [{"command": "cursorWordLeft"}]
        },
        {
          "caption": "Ctrl + →: A word jump back",
          "hold": 2.2,
          "do": [{"command": "cursorWordRight"}]
        },
        {
          "caption": "Concealment OFF: the caret stays where it was",
          "hold": 2.2,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        },
        {
          "caption": "Now the caret walks #bug letter by letter",
          "hold": 2.7,
          "live": 0.27,
          "do": [{"command": "cursorLeft", "times": 4}]
        }
      ]
    },
