{
  "settleMs": 450,
  "scenes": [
    {
      "id": "0101-toggle",
      "title": "Tags — concealment on and off",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Concealment OFF",
          "hold": 1.2,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [1, 1]}],
          "expect": {"press": ["cursorRight", [8, 3], [8, 4]]}
        },
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}],
          "expect": {"unchanged": true, "press": ["cursorRight", [8, 3], [8, 8]]}
        }
      ]
    },
    {
      "id": "0102-search",
      "title": "Tags — search finds the text under the glyph",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"caret": [1, 1]}]
        },
        {
          "caption": "Ctrl + F",
          "hold": 1.5,
          "do": [
            {"command": "editor.actions.findWithArgs", "args": [{"searchString": "done"}]},
            {"command": "editor.action.nextMatchFindAction"}
          ],
          "expect": {"selection": [8, 3, 8, 8]}
        },
        {
          "caption": "Concealment OFF",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}],
          "expect": {"selection": [8, 3, 8, 8]}
        },
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        },
        {
          "caption": "Ctrl + F",
          "hold": 1.5,
          "do": [
            {"command": "editor.actions.findWithArgs", "args": [{"searchString": "bug"}]},
            {"command": "editor.action.nextMatchFindAction"}
          ],
          "expect": {"selection": [9, 3, 9, 7]}
        },
        {
          "caption": "Concealment OFF",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}],
          "expect": {"selection": [9, 3, 9, 7]}
        }
      ]
    },
    {
      "id": "0103-copy",
      "title": "Tags — what the clipboard carries",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Copy",
          "hold": 1.0,
          "live": 0.35,
          "do": [{"select": [8, 1, 9, 22]}],
          "expect": {"selection": [8, 1, 9, 22]}
        },
        {
          "caption": "",
          "hold": 0.8,
          "do": [{"copy": true}, {"openBeside": true}]
        },
        {
          "caption": "Paste",
          "hold": 1.7,
          "do": [{"paste": true}],
          "expect": {"beside": "- #done Ship the fork\n- #bug Fix the gutter"}
        },
        {
          "caption": "",
          "hold": 1.2,
          "do": [{"closeBeside": true}]
        },
        {
          "caption": "",
          "hold": 1.2,
          "live": 0.35,
          "do": [{"select": [8, 3, 8, 8]}],
          "expect": {"selection": [8, 3, 8, 8]}
        },
        {
          "caption": "",
          "hold": 1.2,
          "do": [{"copy": true}, {"openBeside": true}]
        },
        {
          "caption": "",
          "hold": 1.7,
          "do": [{"paste": true}],
          "expect": {"beside": "#done"}
        },
        {
          "caption": "",
          "hold": 1.2,
          "do": [{"closeBeside": true}]
        },
        {
          "caption": "",
          "hold": 1.2,
          "live": 0.35,
          "do": [{"select": [9, 3, 9, 7]}],
          "expect": {"selection": [9, 3, 9, 7]}
        },
        {
          "caption": "",
          "hold": 1.2,
          "do": [{"copy": true}, {"openBeside": true}]
        },
        {
          "caption": "",
          "hold": 1.7,
          "do": [{"paste": true}],
          "expect": {"beside": "#bug"}
        }
      ]
    },
    {
      "id": "0104-caret",
      "title": "Tags — the caret around a glyph",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Start: after glyph",
          "hold": 1.0,
          "do": [{"caret": [8, 8]}],
          "expect": {"caret": [8, 8]}
        },
        {
          "caption": "",
          "hold": 1.0,
          "skip": true,
          "do": [{"caret": [8, 13]}]
        },
        {
          "caption": "",
          "hold": 1.0,
          "live": 0.27,
          "skip": true,
          "do": [{"command": "cursorLeft", "times": 5}]
        },
        {
          "caption": "←",
          "hold": 1.0,
          "do": [{"command": "cursorLeft"}],
          "expect": {"caret": [8, 3]}
        },
        {
          "caption": "→",
          "hold": 1.0,
          "do": [{"command": "cursorRight"}],
          "expect": {"caret": [8, 8]}
        },
        {
          "caption": "Ctrl + ←",
          "hold": 1.0,
          "do": [{"command": "cursorWordLeft"}],
          "expect": {"caret": [8, 3]}
        },
        {
          "caption": "Ctrl + →",
          "hold": 1.0,
          "do": [{"command": "cursorWordRight"}],
          "expect": {"caret": [8, 8]}
        },
        {
          "caption": "Concealment OFF",
          "hold": 1.0,
          "do": [{"setting": "editor.conceal.enabled", "value": false}],
          "expect": {"caret": [8, 8]}
        },
        {
          "caption": "Walk letter by letter",
          "hold": 1.7,
          "live": 0.27,
          "do": [{"command": "cursorLeft", "times": 5}],
          "expect": {"caret": [8, 3]}
        },
        {
          "caption": "Concealment ON",
          "hold": 1.0,
          "do": [{"setting": "editor.conceal.enabled", "value": true}, {"caret": [9, 7]}],
          "expect": {"caret": [9, 7]}
        },
        {
          "caption": "←",
          "hold": 1.0,
          "do": [{"command": "cursorLeft"}],
          "expect": {"caret": [9, 3]}
        },
        {
          "caption": "→",
          "hold": 1.0,
          "do": [{"command": "cursorRight"}],
          "expect": {"caret": [9, 7]}
        },
        {
          "caption": "Ctrl + ←",
          "hold": 1.0,
          "do": [{"command": "cursorWordLeft"}],
          "expect": {"caret": [9, 3]}
        },
        {
          "caption": "Ctrl + →",
          "hold": 1.0,
          "do": [{"command": "cursorWordRight"}],
          "expect": {"caret": [9, 7]}
        },
        {
          "caption": "Concealment OFF",
          "hold": 1.0,
          "do": [{"setting": "editor.conceal.enabled", "value": false}],
          "expect": {"caret": [9, 7]}
        },
        {
          "caption": "Walk letter by letter",
          "hold": 1.7,
          "live": 0.27,
          "do": [{"command": "cursorLeft", "times": 4}],
          "expect": {"caret": [9, 3]}
        }
      ]
    },
    {
      "id": "0105-inside",
      "title": "Tags — a caret inside the range when concealment returns",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Concealment OFF",
          "hold": 1.0,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [8, 8]}],
          "expect": {"caret": [8, 8]}
        },
        {
          "caption": "",
          "hold": 0.8,
          "skip": true,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [8, 13]}]
        },
        {
          "caption": "",
          "hold": 1.0,
          "live": 0.27,
          "skip": true,
          "do": [{"command": "cursorLeft", "times": 7}]
        },
        {
          "caption": "← ←",
          "hold": 1.0,
          "live": 0.27,
          "do": [{"command": "cursorLeft", "times": 2}],
          "expect": {"caret": [8, 6]}
        },
        {
          "caption": "Concealment ON: cursor is pushed out",
          "hold": 2.0,
          // The push is drawn: the model caret stays inside until its next move, which starts from the end.
          "do": [{"setting": "editor.conceal.enabled", "value": true}],
          "expect": {"press": ["cursorRight", [8, 6], [8, 9]]}
        },
        {
          "caption": "Concealment OFF",
          "hold": 0.8,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [9, 7]}],
          "expect": {"caret": [9, 7]}
        },
        {
          "caption": "← ←",
          "hold": 1.0,
          "live": 0.27,
          "do": [{"command": "cursorLeft", "times": 2}],
          "expect": {"caret": [9, 5]}
        },
        {
          "caption": "Concealment ON: cursor is pushed out",
          "hold": 2.0,
          "do": [{"setting": "editor.conceal.enabled", "value": true}],
          "expect": {"press": ["cursorRight", [9, 5], [9, 8]]}
        }
      ]
    },
    {
      "id": "0106-delete",
      "title": "Tags — deleting a glyph",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "",
          "hold": 0.8,
          "do": [{"caret": [8, 8]}],
          "expect": {"caret": [8, 8]}
        },
        {
          "caption": "",
          "hold": 0.8,
          "skip": true,
          "do": [{"caret": [8, 13]}]
        },
        {
          "caption": "",
          "hold": 1.0,
          "live": 0.27,
          "skip": true,
          "do": [{"command": "cursorLeft", "times": 5}]
        },
        {
          "caption": "Backspace",
          "hold": 1.5,
          "do": [{"command": "deleteLeft"}],
          "expect": {"lines": {"8": "-  Ship the fork"}, "caret": [8, 3]}
        },
        {
          "caption": "Concealment OFF",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}],
          "expect": {"lines": {"8": "-  Ship the fork"}}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.5,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"8": "- #done Ship the fork"}}
        },
        {
          "caption": "Concealment ON",
          "hold": 1.0,
          "do": [{"setting": "editor.conceal.enabled", "value": true}],
          "expect": {"press": ["cursorRight", [8, 3], [8, 8]]}
        },
        {
          "caption": "Ctrl + Backspace",
          "hold": 1.5,
          "do": [{"command": "deleteWordLeft"}],
          "expect": {"lines": {"8": "-  Ship the fork"}}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.5,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"8": "- #done Ship the fork"}}
        },
        {
          "caption": "←",
          "hold": 1.0,
          "do": [{"command": "cursorLeft"}],
          "expect": {"caret": [8, 3]}
        },
        {
          "caption": "Ctrl + Delete",
          "hold": 1.5,
          "do": [{"command": "deleteWordRight"}],
          "expect": {"lines": {"8": "-  Ship the fork"}}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.5,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"8": "- #done Ship the fork"}}
        },
        {
          "caption": "",
          "hold": 0.8,
          "do": [{"caret": [9, 7]}],
          "expect": {"caret": [9, 7]}
        },
        {
          "caption": "Backspace",
          "hold": 1.5,
          "do": [{"command": "deleteLeft"}],
          "expect": {"lines": {"9": "-  Fix the gutter"}, "caret": [9, 3]}
        },
        {
          "caption": "Concealment OFF",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}],
          "expect": {"lines": {"9": "-  Fix the gutter"}}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.5,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"9": "- #bug Fix the gutter"}}
        },
        {
          "caption": "Concealment ON",
          "hold": 1.0,
          "do": [{"setting": "editor.conceal.enabled", "value": true}],
          "expect": {"press": ["cursorRight", [9, 3], [9, 7]]}
        },
        {
          "caption": "Ctrl + Backspace",
          "hold": 1.5,
          "do": [{"command": "deleteWordLeft"}],
          "expect": {"lines": {"9": "-  Fix the gutter"}}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.5,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"9": "- #bug Fix the gutter"}}
        },
        {
          "caption": "←",
          "hold": 1.0,
          "do": [{"command": "cursorLeft"}],
          "expect": {"caret": [9, 3]}
        },
        {
          "caption": "Ctrl + Delete",
          "hold": 1.5,
          "do": [{"command": "deleteWordRight"}],
          "expect": {"lines": {"9": "-  Fix the gutter"}}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.5,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"9": "- #bug Fix the gutter"}}
        }
      ]
    },
    {
      "id": "0107-multicursor",
      "title": "Tags — two carets, two glyphs",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "",
          "hold": 0.8,
          "do": [{"caret": [8, 1]}],
          "expect": {"caret": [8, 1]}
        },
        {
          "caption": "Ctrl + Alt + ↓",
          "hold": 1.5,
          "do": [{"command": "editor.action.insertCursorBelow"}],
          "expect": {"caret": [[8, 1], [9, 1]]}
        },
        {
          "caption": "→ →",
          "hold": 1.0,
          "live": 0.27,
          "do": [{"command": "cursorRight", "times": 2}],
          "expect": {"caret": [[8, 3], [9, 3]]}
        },
        {
          "caption": "Delete",
          "hold": 1.5,
          "do": [{"command": "deleteRight"}],
          "expect": {"lines": {"8": "-  Ship the fork", "9": "-  Fix the gutter"}}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.5,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"8": "- #done Ship the fork", "9": "- #bug Fix the gutter"}, "caret": [[8, 3], [9, 3]]}
        },
        {
          "caption": "{",
          "hold": 1.5,
          "live": 0.27,
          "do": [{"type": "{"}],
          "expect": {"lines": {"8": "- {#done Ship the fork", "9": "- {#bug Fix the gutter"}, "caret": [[8, 4], [9, 4]]}
        },
        {
          "caption": "→",
          "hold": 1.0,
          "do": [{"command": "cursorRight"}],
          "expect": {"caret": [[8, 9], [9, 8]]}
        },
        {
          "caption": "}",
          "hold": 1.5,
          "live": 0.27,
          "do": [{"type": "}"}],
          "expect": {"lines": {"8": "- {#done} Ship the fork", "9": "- {#bug} Fix the gutter"}}
        },
        {
          "caption": "Concealment OFF",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}],
          "expect": {"lines": {"8": "- {#done} Ship the fork", "9": "- {#bug} Fix the gutter"}}
        }
      ]
    },
    {
      "id": "0108-vertical",
      "title": "Tags — the caret up and down through glyph lines",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Start: level with the chip's end",
          "hold": 1.0,
          "do": [{"caret": [8, 12]}],
          "expect": {"caret": [8, 12]}
        },
        {
          "caption": "↓ ↑",
          "hold": 0.72,
          "live": 0.43,
          "do": [{"command": "cursorDown"}, {"command": "cursorUp"}],
          "expect": [{"caret": [9, 7]}, {"caret": [8, 12]}]
        },
        {
          "caption": "← ↓ ↑: cursor snaps to the closest end of the chip",
          "hold": 0.72,
          "live": 0.34,
          "do": [{"command": "cursorLeft"}, {"command": "cursorDown"}, {"command": "cursorUp"}],
          "expect": [{"caret": [8, 11]}, {"caret": [9, 7]}, {"caret": [8, 11]}]
        },
        {
          "caption": "← ↓ ↑: cursor snaps to the closest end of the chip",
          "hold": 0.72,
          "live": 0.34,
          "do": [{"command": "cursorLeft"}, {"command": "cursorDown"}, {"command": "cursorUp"}],
          "expect": [{"caret": [8, 10]}, {"caret": [9, 7]}, {"caret": [8, 10]}]
        },
        {
          "caption": "← ↓ ↑: cursor snaps to the closest end of the chip",
          "hold": 0.72,
          "live": 0.34,
          "do": [{"command": "cursorLeft"}, {"command": "cursorDown"}, {"command": "cursorUp"}],
          "expect": [{"caret": [8, 9]}, {"caret": [9, 3]}, {"caret": [8, 9]}]
        },
        {
          "caption": "← ↓ ↑: cursor snaps to the closest end of the chip",
          "hold": 0.72,
          "live": 0.34,
          "do": [{"command": "cursorLeft"}, {"command": "cursorDown"}, {"command": "cursorUp"}],
          "expect": [{"caret": [8, 8]}, {"caret": [9, 3]}, {"caret": [8, 8]}]
        },
        {
          "caption": "← ↓ ↑",
          "hold": 1.7,
          "live": 0.43,
          "do": [{"command": "cursorLeft"}, {"command": "cursorDown"}, {"command": "cursorUp"}],
          "expect": [{"caret": [8, 3]}, {"caret": [9, 3]}, {"caret": [8, 3]}]
        }
      ]
    },
    {
      "id": "0109-typing",
      "title": "Tags — a tag typed in place of another",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "",
          "hold": 0.8,
          "do": [{"caret": [4, 8]}],
          "expect": {"caret": [4, 8]}
        },
        {
          "caption": "Delete letter by letter",
          "hold": 1.5,
          "live": 0.27,
          "do": [{"command": "deleteLeft", "times": 4}],
          "expect": {"lines": {"4": "- # Draft the proposal"}, "caret": [4, 4], "press": ["cursorRight", [4, 3], [4, 4]]}
        },
        {
          "caption": "done",
          "hold": 1.5,
          "live": 0.27,
          "do": [{"type": "done"}],
          "expect": {"lines": {"4": "- #done Draft the proposal"}, "caret": [4, 8], "press": ["cursorRight", [4, 3], [4, 8]]}
        },
        {
          "caption": "x",
          "hold": 1.5,
          "do": [{"type": "x"}],
          "expect": {"lines": {"4": "- #donex Draft the proposal"}, "caret": [4, 9], "press": ["cursorRight", [4, 3], [4, 4]]}
        },
        {
          "caption": "Backspace",
          "hold": 1.5,
          "do": [{"command": "deleteLeft"}],
          "expect": {"lines": {"4": "- #done Draft the proposal"}, "caret": [4, 8], "press": ["cursorRight", [4, 3], [4, 8]]}
        }
      ]
    },
    {
      "id": "0201-toggle",
      "title": "Translation — concealment on and off",
      "example": "02-i18n/checkout.ts",
      "window": [1280, 620],
      "steps": [
        {
          "caption": "Concealment OFF",
          "hold": 1.2,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"setting": "editor.conceal.enabled", "value": false}, {"caret": [1, 1]}],
          "expect": {"press": ["cursorRight", [7, 18], [7, 19]]}
        },
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}],
          "expect": {"unchanged": true, "press": ["cursorRight", [7, 18], [7, 39]]}
        }
      ]
    },
    {
      "id": "0202-wrap",
      "title": "Translation — wrap works on whats visible",
      "example": "02-i18n/comments.ts",
      "window": [1280, 620],
      "steps": [
        {
          "caption": "Concealment OFF",
          "hold": 1.2,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"setting": "editor.conceal.enabled", "value": false}, {"caret": [1, 1]}],
          "expect": {"press": ["cursorDown", [1, 1], [1, 66]]}
        },
        {
          "caption": "Concealment ON",
          "hold": 1.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}],
          "expect": {"unchanged": true, "press": ["cursorDown", [1, 1], [2, 1]]}
        }
      ]
    },
    {
      "id": "0203-delete",
      "title": "Translation — delete",
      "example": "02-i18n/checkout.ts",
      "window": [1280, 620],
      "steps": [
        {
          "caption": "Start",
          "hold": 1.7,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [7, 39]}],
          "expect": {"caret": [7, 39]}
        },
        {
          "caption": "Backspace 1: reveal",
          "hold": 1.7,
          "do": [{"command": "deleteLeft"}],
          "expect": {"unchanged": true, "caret": [7, 39]}
        },
        {
          "caption": "Backspace 2: delete",
          "hold": 1.7,
          "do": [{"command": "deleteLeft", "times": 1}],
          "expect": {"lines": {"7": "  const lines = [t(\"account.greeting\"];"}, "caret": [7, 38]}
        },
        {
          "caption": "Ctrl + Z",
          "hold": 1.0,
          "do": [{"command": "undo"}],
          "expect": {"lines": {"7": "  const lines = [t(\"account.greeting\")];"}, "caret": [7, 39]}
        },
        {
          "caption": "→ →",
          "hold": 1.0,
          "live": 0.45,
          "do": [{"command": "cursorRight", "times": 2}],
          "expect": [{"caret": [7, 40]}, {"caret": [7, 41], "press": ["cursorRight", [7, 18], [7, 39]]}]
        }
      ]
    },
    {
      "id": "0204-edit",
      "title": "Translation — a key edited under the drawn string",
      "example": "02-i18n/checkout.ts",
      "window": [1280, 620],
      "steps": [
        {
          "caption": "Start",
          "hold": 1.2,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [8, 47]}],
          "expect": {"caret": [8, 47]}
        },
        {
          "caption": "Backspace",
          "hold": 1.2,
          "do": [{"command": "deleteLeft"}],
          "expect": {"unchanged": true, "caret": [8, 47]}
        },
        {
          "caption": "← ←",
          "hold": 0.8,
          "live": 0.35,
          "do": [{"command": "cursorLeft", "times": 2}],
          "expect": {"caret": [8, 45]}
        },
        {
