          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [2, 25]}]
        },
        {
          "caption": "Enter, then a new function: fun and -> are drawn as you type",
          "hold": 2.1,
          "live": 0.12,
          "do": [{"type": "\nlet double = fun x -> x * 2"}]
        }
      ]
    },
    {
      "id": "0503-tsarrow",
      "title": "Gallery — => as one ⇒",
      "example": "05-gallery/arrow.ts",
      "window": [1280, 400],
      "steps": [
        {
          "caption": "The caret at the end of the line",
          "hold": 1.1,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [2, 34]}]
        },
        {
          "caption": "Enter, then a new function: => is drawn as you type",
          "hold": 2.1,
          "live": 0.12,
          "do": [{"type": "\nconst double = (x: number) => x * 2;"}]
        }
      ]
    },
    {
      "id": "0504-latex",
      "title": "Gallery — macros as their symbols, shown before they are edited",
      "example": "05-gallery/formula.tex",
      "window": [1280, 400],
      "steps": [
        {
          "caption": "The caret at the end of the line",
          "hold": 1.1,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [2, 24]}]
        },
        {
          "caption": "Enter, then a formula: each macro is drawn as it completes",
          "hold": 1.8,
          "live": 0.12,
          "do": [{"type": "\n$\\gamma \\leq \\pi$"}]
        },
        {
          "caption": "←: the caret on the right of π",
          "hold": 1.1,
          "do": [{"command": "cursorLeft"}]
        },
        {
          "caption": "Backspace: the macro shows itself, nothing is deleted",
          "hold": 1.8,
          "do": [{"command": "deleteLeft"}]
        },
        {
          "caption": "Backspace: now one real character goes",
          "hold": 1.5,
          "do": [{"command": "deleteLeft"}]
        },
        {
          "caption": "Type the letter back",
          "hold": 1.5,
          "live": 0.3,
          "do": [{"type": "i"}]
        },
        {
          "caption": "→: the caret leaves, π is drawn again",
          "hold": 2.1,
          "do": [{"command": "cursorRight"}]
        }
      ]
    },
