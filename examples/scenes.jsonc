          "do": [{"caret": [4, 12]}]
        },
        {
          "caption": "←: through the hidden quote in one press",
          "hold": 1.5,
          "do": [{"command": "cursorLeft"}]
        },
        {
          "caption": "Type: the key grows inside its quotes",
          "hold": 2.1,
          "live": 0.3,
          "do": [{"type": "s"}]
        }
      ]
    },
