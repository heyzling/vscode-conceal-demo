          "caption": "The caret at the end of the line",
          "hold": 1.1,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [4, 56]}]
        },
        {
          "caption": "Enter, Enter: two new lines open below",
          "hold": 1.5,
          "live": 0.6,
          "do": [{"type": "\n\n"}]
        },
        {
          "caption": "Concealment OFF: the id stays on its line",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0401-toggle",
      "title": "Markup — concealment on and off",
      "example": "04-markup/emphasis.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "Concealment OFF: the markers are real text",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [1, 1]}]
        },
        {
          "caption": "Concealment ON: the markers are gone, the link is its text",
          "hold": 1.7,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        }
      ]
    },
    {
      "id": "0402-caret",
      "title": "Markup — a hidden marker costs no keypress",
      "example": "04-markup/emphasis.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "The caret after Use",
          "hold": 1.1,
          "do": [{"caret": [3, 4]}]
        },
        {
          "caption": "→ →: the space and the hidden ** in one press, then b",
          "hold": 1.5,
          "live": 0.5,
          "do": [{"command": "cursorRight", "times": 2}]
        },
        {
          "caption": "← ←: back the same way",
          "hold": 1.5,
          "live": 0.5,
          "do": [{"command": "cursorLeft", "times": 2}]
        },
        {
          "caption": "Concealment OFF: four characters, one press each",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0403-typing",
      "title": "Markup — typing at either visible edge stays inside the pair",
      "example": "04-markup/emphasis.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "The caret at the visible start of bold",
          "hold": 1.1,
          "do": [{"caret": [3, 7]}]
        },
        {
          "caption": "Type at the start: the word grows, still bold",
          "hold": 1.5,
          "live": 0.15,
          "do": [{"type": "semi"}]
        },
        {
          "caption": "The caret at the visible end of the other bold",
          "hold": 1.1,
          "do": [{"caret": [4, 47]}]
        },
        {
          "caption": "Type at the end: the same",
          "hold": 1.5,
          "live": 0.15,
          "do": [{"type": "face"}]
        },
        {
          "caption": "Concealment OFF: both words grew inside their markers",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0404-space",
      "title": "Markup — a space at the visible end lands outside the pair",
      "example": "04-markup/emphasis.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "The caret at the visible end of bold",
          "hold": 1.1,
          "do": [{"caret": [3, 11]}]
        },
        {
          "caption": "Space, then a word: the pair closes first, the word is plain",
          "hold": 1.8,
          "live": 0.15,
          "do": [{"type": " text"}]
        },
        {
          "caption": "Concealment OFF: the space went behind the closing **",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0405-enter",
      "title": "Markup — Enter at the visible end leaves the pair whole",
      "example": "04-markup/emphasis.md",
      "window": [1280, 480],
      "steps": [
        {
          "caption": "The caret at the visible end of bold",
          "hold": 1.1,
          "do": [{"caret": [3, 11]}]
        },
        {
          "caption": "Enter: the rest of the line moves down",
          "hold": 1.5,
          "do": [{"type": "\n"}]
        },
        {
          "caption": "Concealment OFF: the closing ** stayed on its line",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0406-protect",
      "title": "Markup — no delete key reaches a marker",
      "example": "04-markup/emphasis.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "The caret at the visible end of bold",
          "hold": 1.1,
          "do": [{"caret": [3, 11]}]
        },
        {
          "caption": "Backspace: the letter goes, the marker stays",
          "hold": 1.5,
          "do": [{"command": "deleteLeft"}]
        },
        {
          "caption": "Delete: steps over the marker, takes the space behind it",
          "hold": 1.5,
          "do": [{"command": "deleteRight"}]
        },
        {
          "caption": "Concealment OFF: both markers untouched",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0407-orphan",
      "title": "Markup — a marker without a partner shows itself",
      "example": "04-markup/emphasis.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "Concealment OFF, the caret before the opening **",
          "hold": 1.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}, {"caret": [3, 5]}]
        },
        {
          "caption": "Delete one asterisk, as another tool might",
          "hold": 1.5,
          "do": [{"command": "deleteRight"}]
        },
        {
          "caption": "Concealment ON: the pair is broken, so both halves stay in view",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        },
        {
          "caption": "Ctrl + Z: a pair again, hidden at once",
          "hold": 1.8,
          "do": [{"command": "undo"}]
        }
      ]
    },
    {
      "id": "0408-link",
      "title": "Markup — a link shows itself on Backspace and hides again",
      "example": "04-markup/emphasis.md",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "The caret after the link",
          "hold": 1.1,
          "do": [{"caret": [5, 72]}]
        },
        {
          "caption": "Backspace: the whole link shows itself, nothing is deleted",
          "hold": 1.8,
          "do": [{"command": "deleteLeft"}]
        },
        {
          "caption": "←: before the closing bracket",
          "hold": 1.1,
          "do": [{"command": "cursorLeft"}]
        },
        {
          "caption": "Type: the url is edited in place",
          "hold": 1.5,
          "live": 0.15,
          "do": [{"type": "spec/"}]
        },
        {
          "caption": "→ →: the caret leaves, the link is drawn again",
          "hold": 1.8,
          "live": 0.5,
          "do": [{"command": "cursorRight", "times": 2}]
        },
        {
          "caption": "Concealment OFF: the url changed, the text did not",
          "hold": 2.1,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0501-json",
      "title": "Gallery — JSON keys without their quotes",
      "example": "05-gallery/config.json",
      "window": [1280, 440],
      "steps": [
        {
          "caption": "The caret at the end of a line",
          "hold": 1.1,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"setting": "editor.autoClosingQuotes", "value": "never"}, {"caret": [3, 22]}]
