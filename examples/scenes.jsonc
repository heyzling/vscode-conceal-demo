        },
        {
          "caption": "← ↓ ↑: jumps to the closest end of the glyph",
          "hold": 0.72,
          "live": 0.56,
          "do": [{"command": "cursorLeft"}, {"command": "cursorDown"}, {"command": "cursorUp"}]
        },
        {
          "caption": "← ↓ ↑: before the glyph, the columns are matched again",
