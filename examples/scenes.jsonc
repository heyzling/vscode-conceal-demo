          "hold": 1.6,
          "do": [{"setting": "editor.wordWrapColumn", "value": 70}, {"caret": [4, 56]}]
        },
        {
          "caption": "Enter: a new line opens below",
          "hold": 2.2,
          "do": [{"type": "\n"}]
        },
        {
          "caption": "Concealment OFF: the id stays on its line",
          "hold": 3.0,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
    {
      "id": "0701-fold",
      "title": "Fold — long class lists folded, one row each",
      "example": "07-fold/index.html",
      "window": [1280, 560],
      "steps": [
        {
          "caption": "Concealment OFF: three class lists wrap over six rows",
          "hold": 2.7,
          "do": [{ "setting": "editor.wordWrapColumn", "value": 70 }, { "setting": "editor.conceal.enabled", "value": false }, { "caret": [1, 1] }]
        },
        {
          "caption": "Concealment ON: each folded to •••, one row each",
          "hold": 3.0,
          "do": [{ "setting": "editor.conceal.enabled", "value": true }]
        }
      ]
    },
    {
      "id": "0702-reveal",
      "title": "Fold — a fold opens when the caret reaches it",
      "example": "07-fold/index.html",
      "window": [1280, 560],
      "steps": [
        {
          "caption": "foldReveal = adjacent. The caret before a fold",
          "hold": 1.6,
          "do": [{ "setting": "editor.wordWrapColumn", "value": 70 }, { "setting": "conceal-demo.foldReveal", "value": "adjacent" }, { "caret": [4, 14] }]
        },
        {
          "caption": "→: the caret reaches the fold, it opens",
          "hold": 2.2,
          "live": 0.7,
          "do": [{ "command": "cursorRight", "times": 2 }]
        },
        {
          "caption": "→: inside the value",
          "hold": 1.2,
          "live": 0.27,
          "do": [{ "command": "cursorRight", "times": 6 }]
        },
        {
          "caption": "↑: the caret leaves, the fold closes",
          "hold": 2.5,
          "do": [{ "command": "cursorUp" }]
        },
        {
          "caption": "foldReveal = click. The caret before the fold again",
          "hold": 1.6,
          "do": [{ "setting": "conceal-demo.foldReveal", "value": "click" }, { "caret": [4, 14] }]
        },
        {
          "caption": "→: the caret jumps over the fold, it stays closed; a click opens it",
          "hold": 2.7,
          "live": 0.7,
          "do": [{ "command": "cursorRight", "times": 3 }]
        }
      ]
    },
    {
      "id": "0704-click",
      "title": "Fold — a click opens a fold (recorded by hand)",
      "example": "07-fold/index.html",
      "window": [1280, 560],
      "steps": [
        {
          "caption": "foldReveal = click: a click on a fold opens it, a click elsewhere closes it",
          "manual": true,
          "do": [{ "setting": "editor.wordWrapColumn", "value": 70 }, { "setting": "conceal-demo.foldReveal", "value": "click" }, { "caret": [3, 1] }]
        }
      ]
    }
  ]
}
