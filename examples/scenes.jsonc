    {
      "id": "0106-delete",
      "title": "Tags — deleting a glyph",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Put the caret at the right of the glyph",
          "hold": 1.6,
          "do": [{"caret": [8, 8]}]
        },
        {
          "caption": "Put the caret after Ship",
          "hold": 1.6,
          "skip": true,
          "do": [{"caret": [8, 13]}]
        },
        {
          "caption": "Move left to the glyph",
          "hold": 1.5,
          "live": 0.27,
          "skip": true,
          "do": [{"command": "cursorLeft", "times": 5}]
        },
        {
          "caption": "Backspace deletes the whole glyph in one press",
          "hold": 2.5,
          "do": [{"command": "deleteLeft"}]
        },
        {
          "caption": "Concealment OFF: #done is gone from the file",
          "hold": 2.5,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        },
        {
          "caption": "Ctrl + Z: Undo brings #done back in one step",
          "hold": 2.5,
          "do": [{"command": "undo"}]
        },
        {
          "caption": "Concealment ON: the glyph is back",
          "hold": 2.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        },
        {
          "caption": "Ctrl + Backspace: takes the glyph as one word",
          "hold": 2.5,
          "do": [{"command": "deleteWordLeft"}]
        },
        {
          "caption": "Ctrl + Z: back again",
          "hold": 2.5,
          "do": [{"command": "undo"}]
        },
        {
          "caption": "←: to the left of the glyph",
          "hold": 2.2,
          "do": [{"command": "cursorLeft"}]
        },
        {
          "caption": "Ctrl + Delete: takes the glyph as one word, forward",
          "hold": 2.5,
          "do": [{"command": "deleteWordRight"}]
        },
        {
          "caption": "Ctrl + Z: back again",
          "hold": 2.5,
          "do": [{"command": "undo"}]
        },
        {
          "caption": "Put the caret at the right of the chip",
          "hold": 1.6,
          "do": [{"caret": [9, 7]}]
        },
        {
          "caption": "Backspace deletes the whole chip in one press",
          "hold": 2.5,
          "do": [{"command": "deleteLeft"}]
        },
        {
          "caption": "Concealment OFF: #bug is gone from the file",
          "hold": 2.5,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        },
        {
          "caption": "Ctrl + Z: Undo brings #bug back in one step",
          "hold": 2.5,
          "do": [{"command": "undo"}]
        },
        {
          "caption": "Concealment ON: the chip is back",
          "hold": 2.2,
          "do": [{"setting": "editor.conceal.enabled", "value": true}]
        },
        {
          "caption": "Ctrl + Backspace: takes the chip as one word",
          "hold": 2.5,
          "do": [{"command": "deleteWordLeft"}]
        },
        {
          "caption": "Ctrl + Z: back again",
          "hold": 2.5,
          "do": [{"command": "undo"}]
        },
        {
          "caption": "←: to the left of the chip",
          "hold": 2.2,
          "do": [{"command": "cursorLeft"}]
        },
        {
          "caption": "Ctrl + Delete: takes the chip as one word, forward",
          "hold": 2.5,
          "do": [{"command": "deleteWordRight"}]
        },
        {
          "caption": "Ctrl + Z: back again",
          "hold": 2.5,
          "do": [{"command": "undo"}]
        }
      ]
    },
    {
      "id": "0107-multicursor",
      "title": "Tags — two carets, two glyphs",
      "example": "01-tags/tags.md",
      "window": [1280, 500],
      "steps": [
        {
          "caption": "Put the caret at the start of the #done line",
          "hold": 1.6,
          "do": [{"caret": [8, 1]}]
        },
        {
          "caption": "Ctrl + Alt + ↓: a second caret on the #bug line",
          "hold": 2.0,
          "do": [{"command": "editor.action.insertCursorBelow"}]
        },
        {
          "caption": "Move both carets to the glyphs",
          "hold": 2.2,
          "live": 0.27,
          "do": [{"command": "cursorRight", "times": 2}]
        },
        {
          "caption": "Delete removes both glyphs in one press",
          "hold": 2.7,
          "do": [{"command": "deleteRight"}]
        },
        {
          "caption": "Ctrl + Z: Undo brings both back",
          "hold": 2.2,
          "do": [{"command": "undo"}]
        },
        {
          "caption": "Type before both glyphs",
          "hold": 2.2,
          "live": 0.27,
          "do": [{"type": "{"}]
        },
        {
          "caption": "→: crosses both glyphs",
          "hold": 2.2,
          "do": [{"command": "cursorRight"}]
        },
        {
          "caption": "Type after both glyphs",
          "hold": 2.2,
          "live": 0.27,
          "do": [{"type": "}"}]
        },
        {
          "caption": "Concealment OFF: {#done} and {#bug}, tags untouched",
          "hold": 3.0,
          "do": [{"setting": "editor.conceal.enabled", "value": false}]
        }
      ]
    },
